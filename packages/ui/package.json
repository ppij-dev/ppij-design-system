{
  "name": "ppij-design-system",
  "version": "0.1.0",
  "description": "PPIJ branding and design system: tokens and React components on shadcn/ui and Tailwind CSS v4",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/assemble-dist.mjs",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build -o ../../storybook-static"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.7.0",
    "vaul": "^1.1.2",
    "react-parallax-tilt": "1.7.346",
    "react-barcode": "1.6.1",
    "html-to-image": "1.11.13"
  },
  "devDependencies": {
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@storybook/addon-docs": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/theming": "^8.6.14",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "8.6.14",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.3.5"
  }
}
